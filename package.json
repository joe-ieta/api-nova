{
  "name": "api-nova-monorepo",
  "version": "1.0.0",
  "packageManager": "npm@10.9.2",
  "description": "ApiNova monorepo for API gateway management and AI-ready API capability delivery",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "preinstall": "node scripts/verify-package-manager.js",
    "verify:package-manager": "node scripts/verify-package-manager.js",
    "build": "node scripts/build.js",
    "build:packages": "node scripts/build.js --non-ui",
    "build:parser-chain": "node scripts/verify-parser-propagation.js --build-only --include-consumer-builds",
    "prepack": "node scripts/build.js",
    "pack": "npm pack --workspace api-nova-server && npm pack --workspace api-nova-parser",
    "changeset": "changeset",
    "version:packages": "changeset version && npm install --package-lock-only",
    "release": "npm run build && changeset publish",
    "dev": "node scripts/dev.js",
    "dev:ui": "npm run dev --workspace api-nova-ui",
    "clean": "node scripts/clean.js",
    "clean:build": "node scripts/clean.js --build-only",
    "diagnostic": "node scripts/diagnostic.js",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "verify:runtime-closure": "node scripts/verify-runtime-closure.js",
    "verify:runtime-security-integration": "node scripts/verify-runtime-security-integration.cjs",
    "verify:parser-chain": "node scripts/verify-parser-propagation.js",
    "verify:parser-chain:full": "node scripts/verify-parser-propagation.js --include-consumer-builds",
    "verify:f3-dual-runtime": "node scripts/verify-f3-dual-runtime.cjs",
    "verify:f3-n-matrix": "node scripts/verify-f3-n-matrix.cjs",
    "verify:mcp-observability-matrix": "node scripts/verify-mcp-observability-matrix.cjs",
    "verify:obs-06-02": "node scripts/verify-obs-06-02.cjs",
    "verify:ext-09": "node scripts/verify-ext-09.cjs",
    "verify:obs-16-03": "node scripts/verify-obs-16-03.cjs",
    "verify:obs-16-local-unit": "node scripts/verify-obs-16-local-unit.cjs",
    "verify:obs-15-full-chain": "node scripts/verify-obs-15-full-chain.cjs",
    "verify:obs-14-03e3": "node scripts/verify-obs-14-03e3.cjs",
    "verify:obs-14-05d": "node scripts/verify-obs-14-05d.cjs",
    "verify:obs-13-02": "node scripts/verify-obs-13-02.cjs",
    "verify:mail-02": "node scripts/test-mail-delivery.cjs",
    "verify:e2-01": "node scripts/verify-e2-01.cjs",
    "verify:e2-02": "node scripts/verify-e2-02.cjs",
    "verify:f1-02c3g6": "node scripts/verify-f1-02c3g6.cjs",
    "verify:ext-06": "node scripts/verify-ext-06.cjs",
    "verify:ext-07": "node scripts/verify-ext-07.cjs",
    "verify:ext-08": "node scripts/verify-ext-08.cjs",
    "verify:ext-01-05": "node scripts/verify-ext-01-05.cjs",
    "verify:env-01": "node scripts/verify-env-01.cjs",
    "verify:proxy-trust": "node scripts/verify-proxy-trust.cjs",
    "verify:obs-16-04-tls-trust": "node scripts/verify-obs-16-04-tls-trust.cjs",
    "verify:prod-04c": "node scripts/verify-prod-04c.cjs",
    "verify:obs-16-04-backup-restore": "node scripts/verify-obs-16-04-backup-restore.cjs",
    "verify:obs-16-04-performance": "node scripts/verify-obs-16-04-performance.cjs"
  },
  "keywords": [
    "mcp",
    "swagger",
    "openapi",
    "monorepo",
    "model-context-protocol"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.5",
    "@types/node": "^22.15.21",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.10",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3"
  }
}
